# Telegram
BOT_TOKEN=1234567890:replace_with_telegram_bot_token

# Airtable
# Use a Personal Access Token with data.records:read permission for the selected base.
AIRTABLE_API_KEY=pat_replace_with_airtable_personal_access_token
AIRTABLE_BASE_ID=app_replace_with_base_id
AIRTABLE_TABLE_NAME=Objects

# Stable numeric field used by the bot.
# Recommended Airtable field type: Autonumber.
AIRTABLE_ROW_ID_FIELD=Row Number

# Airtable field mapping.
AIRTABLE_TITLE_FIELD=Title
AIRTABLE_AUTHOR_FIELD=Author
AIRTABLE_TECHNIQUE_FIELD=Technique
AIRTABLE_SIZE_FIELD=Size
AIRTABLE_YEAR_FIELD=Year
AIRTABLE_PRICE_FIELD=Price
AIRTABLE_IMAGE_FIELD=Image

# Optional runtime tuning.
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=4

# Optional PDF font override. Usually not needed on Windows/macOS/Linux.
# Use a TTF font with Cyrillic support if PDF text renders incorrectly.
PDF_FONT_PATH=
PDF_BOLD_FONT_PATH=
